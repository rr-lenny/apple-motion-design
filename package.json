{
  "name": "apple-motion-design",
  "private": true,
  "type": "module",
  "scripts": {
    "preview": "npx serve -l 5173 .",
    "audio": "node scripts/audio.mjs",
    "stills": "node scripts/render.mjs --stills 1.5,4.6,7.2,8.3,10.2,12.9,15.4,18.6,22.6",
    "render": "node scripts/audio.mjs && node scripts/render.mjs",
    "render:draft": "node scripts/render.mjs --fps 30 --sub 1 --out out/draft.mp4",
    "preview:v2": "npx serve -l 5173 . # then open /v2/",
    "stills:v2": "node scripts/render.mjs --page v2/index.html --stillsDir out/stills-v2 --stills 0.9,2.7,5.6,9.3,11.6,15.7,16.2,19.3,22.4,24",
    "render:v2": "node scripts/audio-v2.mjs && node scripts/render.mjs --page v2/index.html --fps 30 --sub 4 --out out/lumen-v2.mp4 --audio out/soundtrack-v2.wav"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
